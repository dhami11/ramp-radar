# Leave ONRAMPER_API_KEY empty to run in mock mode (no network calls to Onramper).
ONRAMPER_API_KEY=
ONRAMPER_API_URL=https://api-stg.onramper.com
# Ed25519 private key (PEM) for Signature V2. Generate with: npm run keys
ONRAMPER_SIGNING_KEY_FILE=
# Secret Onramper issues when webhooks are enabled for your API key.
ONRAMPER_WEBHOOK_SECRET=dev-webhook-secret
PORT=8787
DB_PATH=data/ramp-radar.db
